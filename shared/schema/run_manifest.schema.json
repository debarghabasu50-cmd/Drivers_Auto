{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunManifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "start_time",
    "snapshot",
    "config",
    "step_toggles"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["RUNNING", "SUCCEEDED", "PARTIAL", "FAILED"] },
    "start_time": { "type": "string" },
    "end_time": { "type": ["string", "null"] },
    "image": { "type": "string" },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": { "type": "string" },
        "uri": { "type": "string" },
        "data_hash": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "config_version": { "type": "string" },
        "uri": { "type": "string" }
      }
    },
    "step_toggles": { "type": "object" },
    "plan": { "type": "object" },
    "steps": { "type": "object" },
    "completeness": { "type": "object" },
    "lineage": { "type": "object" }
  }
}
