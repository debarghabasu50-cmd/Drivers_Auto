{
  "division_name": "ELDS",
  "input_file": "data/sample_data.xlsx",
  "mapping_file": "data/category_mapping_ELDS_v15.xlsx",
  "train_end": "2025-10-01",
  "mandatory_kpis": {
    "enabled": true,
    "match_mode": "contains",
    "items": [
      "Data center | Hyperscaler | Quarterly",
      "United States | Oil and Gas Capex | Quarterly",
      "Europe | Oil and Gas Capex | Quarterly"
    ],
    "override_prefilter": true,
    "override_lag_rejection": true,
    "override_family_survival": true,
    "override_top_selection": true,
    "priority_set": "P0"
  },
  "country_contribution_file": "data/country_contribution_ELDS.xlsx",
  "output_dir": "feature_selection_outputs",
  "date_col": "date",
  "modelling_level_col": "modelling_level",
  "raw_target_col": "orders_received_net",
  "target_col": "orders_received_net_rolling",
  "rolling_window": 1,
  "drop_raw_target_after_rolling": true,
  "ignore_cols": [
    "modelling_level"
  ],
  "mapping": {
    "kpi_col": "KPI",
    "category_col": "Category",
    "theme_col": "Theme"
  },
  "prefilter": {
    "missing_threshold": 0.2,
    "min_unique": 2,

    "cv_mode": "percentile",
    "absolute_min_cv": 1.0,
    "cv_drop_percentile": 0.10,
    "cv_warn_percentile": 0.25,

    "cv_threshold": 5.0
  },
  "lag_selection": {
    "default_lags": [3, 6, 9],
    "min_abs_corr_threshold": 0.1,
    "min_qualifying_lags": 2,
    "use_dtw_tiebreak": true,

    "category_lags": {
      "Internal": [3, 6, 9],
      "Data Center": [3, 6, 9],
      "Manufacturing": [3, 6, 9],
      "Construction": [3, 6, 9],
      "Commodities & Extraction": [3, 6, 9],
      "Macro Economy": [3, 6, 9],
      "Competitor": [3, 6, 9],
      "Infrastructure & Construction": [3, 6, 9],
      "Energy & Utilities": [3, 6, 9],
      "Socio-Demographic": [3, 6, 9],
      "Business": [3, 6, 9]
    },

    "data_centre_regex": "\\bdata\\s*cent(re|er)\\b",
    "transform_method": "log_yoy",
    "yoy_period": 12,
    "lag_gap_threshold": 0.1,
    "min_points": 12,
    "run_full_lag_diagnostics": false,
    "full_lag_max_lag": 12,
    "full_lag_transform_method": "yoy"
  },
  "mi_signal": {
    "transform_method": "log_yoy",
    "yoy_period": 12,
    "n_neighbors": 3,
    "random_state": 42,
    "min_points": 12,
    "max_lag": 12,
    "already_lagged": true
  },
  "cointegration": {
    "alpha": 0.05,
    "floor_value": 0.65,
    "min_points": 20,
    "already_lagged": true
  },
  "lcen": {
    "weight": 0.1,
    "signal_weight": 0.9,
    "n_bootstraps": 500,
    "alphas_logspace_start": -3,
    "alphas_logspace_end": 1,
    "alphas_count": 10,
    "l1_ratios": [
      0.1,
      0.3,
      0.5,
      0.7,
      0.9,
      1.0
    ],
    "random_state": 42,
    "block_size": null,
    "coef_tol": 1e-08,
    "already_lagged": true
  },
  "dtw_joint_score": {
    "transform_method": "log_yoy",
    "yoy_period": 12,
    "min_points": 12,
    "fcs_col": "FCS_pre",

    "dtw_scaling_method": "exponential",
    "dtw_lambda": 0.1,
    "dtw_lambda_strategy": "median_inverse",

    "fcs_weight": 0.7,
    "dtw_weight": 0.3
  },
  "family_survival": {
    "category_col": "Category",
    "score_col": "joint_score",
    "quantile": 0.2,
    "min_floor": 0.4
  },
  "country_multiplier": {
    "country_col": "Country",
    "contribution_col": "Contribution",
    "base": 0.85,
    "variable_weight": 0.15,
    "default_multiplier": 1.0,
    "score_col": "joint_score",
    "output_col": "FCS_star"
  },
  "top_selection": {
    "feature_col": "Feature",
    "category_col": "Category",
    "score_col": "FCS_star",
    "min_score": null
  },
  "partial_corr": {
    "target_col": "orders_received_net",
    "feature_col": "Feature",
    "category_col": "Category",
    "best_lag_col": "Best_Lag",
    "score_col": "FCS_star",
    "status_col": "Status",
    "partial_corr_threshold": 0.1,
    "min_points": 12
  },
  "country_diversity": {
    "enabled": true,
    "top_n_countries": 3,
    "max_selected_features": 7,
    "score_col": "FCS_star",
    "status_col": "Status",
    "feature_col": "Feature",
    "category_col": "Category",
    "country_col": "country_raw",
    "mapped_kpi_col": "Mapped_KPI",
    "contribution_country_col": "Country",
    "contribution_col": "Contribution",
    "allow_replace_internal": false,
    "min_candidate_score": null
  },
  "post_selection_sets": {
  "enabled": true,
  "fcs_threshold_p1": 0.5,
  "partial_corr_threshold_p1": 0.1,

  "fcs_threshold_p2": 0.5,
  "dtw_threshold_p2": 0.5,

  "fcs_threshold_p3": 0.5,
  "dtw_threshold_p3": 0.5,
  "score_col": "FCS_star",
  "dtw_col": "dtw_score",
  "partial_corr_col": "partial_corr",
  "status_col": "Status",
  "set_col": "Priority_Set"
  }
}